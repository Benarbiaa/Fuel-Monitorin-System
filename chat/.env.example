# ── Groq API ──────────────────────────────────────────────────────────────────
# Same key as your project-root .env — get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Backend integration ──────────────────────────────────────────────────────
# "real" = calls your actual FastAPI backend for live data
# "mock" = uses chat/mocks/backend_mock.py instead (no backend needed, good for testing chat in isolation)
BACKEND_MODE=real
BACKEND_URL=http://localhost:8000

# ── Service ───────────────────────────────────────────────────────────────────
SERVICE_PORT=8001